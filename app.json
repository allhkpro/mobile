{
  "expo": {
    "name": "AI Smart Home",
    "slug": "ai-smart-home",
    "version": "0.3.0",
    "scheme": [
      "smarthome",
      "aiknx"
    ],
    "platforms": [
      "ios"
    ],
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0A0B"
    },
    "ios": {
      "bundleIdentifier": "com.smarthome.app",
      "buildNumber": "1",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "用于工程师记录施工现场和扫描设备二维码。",
        "NSPhotoLibraryUsageDescription": "用于选择和上传施工现场照片。",
        "NSPhotoLibraryAddUsageDescription": "用于保存设备快照到相册。",
        "NSMicrophoneUsageDescription": "用于录制你的描述并生成自动化场景",
        "NSSpeechRecognitionUsageDescription": "把语音转成文字喂给 AI 生成器",
        "NSLocalNetworkUsageDescription": "用于发现和连接本地 KNX 智能家居网关。",
        "NSBonjourServices": [
          "_knx._tcp",
          "_smarthome-gateway._tcp",
          "_aiknx-gateway._tcp",
          "_zhitong-setup._tcp"
        ],
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      },
      "associatedDomains": []
    },
    "plugins": [
      "expo-router",
      "expo-video",
      "expo-speech-recognition"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "REPLACE_WITH_EAS_PROJECT_ID_AFTER_eas_init"
      }
    }
  }
}
